# Copy to .env.local for `npm run dev`, or better: `npx vercel env pull .env.local` (application.md
# section 12.5). Never commit real values. Every variable is validated by src/lib/env.ts.
# Feature-specific ones are only required by the code that uses them, so the site builds before
# the database and auth are wired up.
#
# Vercel scopes: [P] Production, [V] Preview, [D] Development. "dev" = the vije-sh-dev Supabase
# project, "prod" = vije-sh-prod. .env.local must always point at the dev project.

# [P] https://vije.sh   [V] unset   [D] http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Supabase transaction pooler, port 6543, role app_rw) ---------------------------
# postgresql://app_rw.<project-ref>:<password>@<transaction-pooler-host>:6543/postgres
# [P] prod   [V] dev   [D] dev. Never the session pooler or the postgres user.
DATABASE_URL=
# Supabase CA certificate (PEM text; real newlines or \n). [P] prod   [V] dev   [D] dev
DATABASE_CA_CERT=

# --- Supabase Auth (identity only) ------------------------------------------------------------
# [P] prod   [V] dev   [D] dev
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; used solely to delete accounts. [P] prod   [V] dev   [D] dev
SUPABASE_SECRET_KEY=

# --- Cloudflare Turnstile ---------------------------------------------------------------------
# [P] real keys   [V] [D] Cloudflare's always-pass test keys:
#   site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Cloudflare R2 (images) -------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_IMAGE_BASE_URL=https://img.vije.sh

# --- Vercel Cron ------------------------------------------------------------------------------
# [P] only (openssl rand -hex 32). Vercel Cron runs on production only.
CRON_SECRET=

# --- Live feeds -------------------------------------------------------------------------------
# Optional. A fine-grained GitHub token with no permissions raises the GitHub API limit for the
# release and advisory feeds from 60 to 5,000 requests an hour (Vercel's egress IPs are shared).
GITHUB_TOKEN=
# Set to 1 to skip upstream calls and serve built-in sample data (CI, offline work, e2e tests).
FEEDS_OFFLINE=

# --- Later ------------------------------------------------------------------------------------
RESEND_API_KEY=

# AUTH_MODE and TEST_AUTH_SECRET belong in .env.test only (see .env.test.example). Never set them
# here or on Vercel: AUTH_MODE=test replaces OAuth with a test cookie and is refused on Vercel.
