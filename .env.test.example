# Copy to .env.test for integration and feature (e2e) tests. Never a Supabase project: the tests
# empty the tables. The setup script and test helpers refuse any host other than localhost /
# 127.0.0.1. Local PostgreSQL 17 + contrib with a superuser role (application.md section 12.5), or:
#   docker run --rm -p 54329:5432 -e POSTGRES_PASSWORD=test postgres:17
TEST_DATABASE_URL=postgres://postgres:test@localhost:54329/postgres
FEEDS_OFFLINE=1

# Test sign-in (application.md 13.4): getCurrentUser() reads an HMAC-signed `test_session` cookie
# instead of asking Supabase. Refused when VERCEL is set. The secret must be 32+ characters
# (openssl rand -hex 32).
AUTH_MODE=test
TEST_AUTH_SECRET=

# Playwright passes these (and DATABASE_URL=TEST_DATABASE_URL) to next build / next start, so e2e
# never reads the dev project from .env.local. Cloudflare's always-pass Turnstile test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
