# Copy to .env.test for integration and feature tests. Must point at a local Postgres:
#   docker run --rm -p 54329:5432 -e POSTGRES_PASSWORD=test postgres:17
# The setup script and test helpers refuse any host other than localhost / 127.0.0.1.
TEST_DATABASE_URL=postgres://postgres:test@localhost:54329/postgres
FEEDS_OFFLINE=1
