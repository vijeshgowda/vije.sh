# Copy to .env.local for `npm run dev`. Never commit real values.
# Every variable is validated by src/lib/env.ts. Feature-specific ones are only required by the
# code that uses them, so the site builds before the database and auth are wired up.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Supabase transaction pooler, port 6543, role app_rw) ---------------------------
DATABASE_URL=
# Supabase root certificate (PEM text, newlines as \n)
DATABASE_CA_CERT=

# --- Supabase Auth (identity only) ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; used solely to delete accounts
SUPABASE_SECRET_KEY=

# --- Cloudflare Turnstile -------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cloudflare R2 (images) -----------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_IMAGE_BASE_URL=https://img.vije.sh

# --- Vercel Cron ----------------------------------------------------------------------------
CRON_SECRET=

# --- Live feeds -----------------------------------------------------------------------------
# Optional. A fine-grained GitHub token with no permissions raises the GitHub API limit for the
# release and advisory feeds from 60 to 5,000 requests an hour (Vercel's egress IPs are shared).
GITHUB_TOKEN=
# Set to 1 to skip upstream calls and serve built-in sample data (CI, offline work, e2e tests).
FEEDS_OFFLINE=

# --- Later ----------------------------------------------------------------------------------
RESEND_API_KEY=
